{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "analytics",
      "rules": "firestore.analytics.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "demo",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "scripts"
      ],
      "predeploy": [
        "pnpm --filter demo-functions run build"
      ]
    }
  ],
  "hosting": {
    "site": "demo-app-shop",
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "pnpm --filter demo-web run build"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
